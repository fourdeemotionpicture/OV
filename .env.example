# ==============================================================================
# OV™ — ORIGINAL VERSION | PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# Configure these variables in your Vercel Project Dashboard (Settings -> Environment Variables)
# DO NOT commit real secrets or production credentials into this file or Git.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL - Supabase / Neon / AWS RDS)
# ------------------------------------------------------------------------------
# Neon / Supabase Connection URI with SSL enabled:
DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/ov_production?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64-char key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_signing_key_replace_with_random_hex_string_64_chars
JWT_EXPIRES_IN=7d
ADMIN_SESSION_COOKIE=ov_admin_token

# ------------------------------------------------------------------------------
# 3. INITIAL OWNER CREDENTIALS (Used to seed the first Owner account)
# ------------------------------------------------------------------------------
INITIAL_OWNER_EMAIL=admin@ovclothing.com
INITIAL_OWNER_PASSWORD=ChangeThisPasswordOnFirstLogin123!
INITIAL_OWNER_NAME=OV Store Owner

# ------------------------------------------------------------------------------
# 4. SHIPROCKET LOGISTICS INTEGRATION (Official B2C Shipping API)
# ------------------------------------------------------------------------------
# Found in Shiprocket Dashboard -> Settings -> API -> Configure
SHIPROCKET_API_EMAIL=shiprocket_api_user@ovclothing.com
SHIPROCKET_API_PASSWORD=your_secure_shiprocket_api_password
# Custom Secret Token configured under Shiprocket Webhook Settings to verify incoming events:
SHIPROCKET_WEBHOOK_SECRET=your_custom_webhook_secret_token

# Default Dispatch Location Details (Used for courier pickup scheduling)
SHIPROCKET_PICKUP_LOCATION=Primary_Warehouse
SHIPROCKET_PICKUP_PINCODE=600006

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay / Cashfree)
# ------------------------------------------------------------------------------
# Found in Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
# Found in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 6. STORE & CLIENT SETTINGS
# ------------------------------------------------------------------------------
STORE_NAME=OV™ — ORIGINAL VERSION
STORE_URL=https://ov-green.vercel.app
SUPPORT_EMAIL=support@ovclothing.com
SUPPORT_PHONE=+919876543210
CURRENCY=INR
TAX_RATE_PERCENTAGE=5
FREE_SHIPPING_THRESHOLD=1999
STANDARD_SHIPPING_FEE=99
COD_SURCHARGE=50
